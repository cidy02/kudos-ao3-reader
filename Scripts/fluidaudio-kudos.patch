+    /// Replace each run of `minimumRun` or more identical letters with a
+    /// single copy of that letter. Non-letters (digits, hyphens) are kept
+    /// as written so we don't invent a new token shape.
+    private static func collapseLetterRuns(_ word: String, minimumRun: Int) -> String {
