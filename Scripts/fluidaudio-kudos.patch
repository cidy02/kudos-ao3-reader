+    /// The four-dictionary lookup used for a direct lexicon hit. Recoveries
+    /// below call this on their reconstructed spelling so they cannot drift
+    /// from the maps a normal word uses.
+    private func lexiconPhonemes(for candidate: String) -> String? {
+        let normalized = Self.normalizeKey(candidate)
+        let lowered = candidate.lowercased()
+        guard let phonemes = caseSensitiveWordToPhonemes[candidate]
+            ?? caseSensitiveWordToPhonemes[normalized]
+            ?? wordToPhonemes[lowered]
+            ?? wordToPhonemes[normalized],
