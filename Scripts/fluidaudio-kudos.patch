+
+        var index = lowered.index(after: lowered.startIndex)
+        while index < lowered.endIndex {
+            let candidate = String(lowered[..<index]) + "'" + String(lowered[index...])
+            if !Self.isLetterPlural(candidate), let hit = lexiconPhonemes(for: candidate) {
+                return hit
+            }
+            index = lowered.index(after: index)
+        }
+        return nil
+    }
