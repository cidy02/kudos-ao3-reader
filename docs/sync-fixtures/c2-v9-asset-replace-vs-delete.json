        "reason": "explicit"
      },
      "requires": [
        "s1"
      ],
      "gen": "g0"
    },
    {
      "id": "t1",
      "writer": "inc-b",
      "stamp": [
        7,
        "inc-b",
        2
      ],
      "kind": "work.restore",
      "target": "11111111-1111-4111-8111-111111111111",
      "payload": {
        "deletions": [
          "s1"
        ]
      },
      "requires": [
        "s1"
      ]
    }
  ],
  "scenarios": [
    {
      "name": "replace vs delete",
      "ops": [
        "r1",
        "s1"
