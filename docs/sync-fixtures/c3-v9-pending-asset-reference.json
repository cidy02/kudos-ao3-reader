{
  "schema": "kudos.sync-fixture/1",
  "id": "c3",
  "slice": "c",
  "kind": "v9-concurrency",
  "title": "Metadata commits with a pending asset reference; availability follows verified bytes",
  "refs": [
    "DEC-13",
    "plan v3.1 \u00a7 C Assets"
  ],
  "initial": {
    "works": [
      {
        "key": "11111111-1111-4111-8111-111111111111",
        "gen": "g0",
        "lifecycle": "live",
        "asset": {
          "epub": {
            "digest": "d1",
            "available": true
          }
        }
      }
    ],
    "blobs": [
      "d1"
    ]
  },
  "ops": [
    {
      "id": "r1",
      "writer": "inc-a",
      "stamp": [
        2,
        "inc-a",
        1
      ],
      "kind": "asset.replace",
      "target": "11111111-1111-4111-8111-111111111111",
      "payload": {
        "assetKind": "epub",
        "digest": "d2",
        "baseDigest": "d1",
        "size": 1200
      },
      "gen": "g0"
    }
  ],
  "events": [
    {
      "id": "blob",
      "kind": "blobVisible",
      "digest": "d2",
      "verified": true
    },
    {
      "id": "badblob",
      "kind": "blobVisible",
      "digest": "d2",
      "verified": false,
      "note": "size or digest mismatch: stays pending, retried"
    }
  ],
  "orders": [
    [
      "r1",
      "blob"
    ],
    [
      "blob",
      "r1"
    ],
    [
      "r1",
      "badblob",
      "blob"
    ]
  ],
  "duplicates": "deliver every op twice",
  "expected": {
    "afterEachPrefix": {
      "[r1]": {
        "epub": {
          "digest": "d2",
          "available": false,
          "state": "pending"
        },
        "readerKeepsOpening": "d1 local copy"
      },
      "[blob]": {
        "epub": {
          "digest": "d1"
        },
        "note": "blob known, no reference yet"
      },
      "[r1,blob] or [blob,r1]": {
        "epub": {
          "digest": "d2",
          "available": true
        }
      }
    },
    "final": {
      "works": [
        {
          "key": "11111111-1111-4111-8111-111111111111",
          "asset": {
            "epub": {
              "digest": "d2",
              "available": true
            }
          }
        }
      ]
    },
    "appliedCut": {
      "inc-a": 1
    },
    "pending": []
  },
  "note": "`available` is device-local and never synced; the reference is."
}
