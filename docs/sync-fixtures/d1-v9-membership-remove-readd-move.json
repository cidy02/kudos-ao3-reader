{
  "schema": "kudos.sync-fixture/1",
  "id": "d1",
  "slice": "ext",
  "kind": "v9-concurrency",
  "title": "Remove and re-add racing a move on a queue membership",
  "refs": [
    "M1",
    "M2"
  ],
  "initial": {
    "queues": [
      {
        "key": "q1",
        "members": [
          {
            "work": "X",
            "rank": 1
          },
          {
            "work": "Y",
            "rank": 2
          }
        ]
      }
    ]
  },
  "ops": [
    {
      "id": "m1",
      "writer": "inc-a",
      "stamp": [
        5,
        "inc-a",
        1
      ],
      "kind": "queue.membership.remove",
      "target": "q1|Y",
      "payload": {}
    },
    {
      "id": "m2",
      "writer": "inc-a",
      "stamp": [
        6,
        "inc-a",
        2
      ],
      "kind": "queue.membership.add",
      "target": "q1|Y",
      "payload": {
        "rank": 2
      }
    },
    {
      "id": "m3",
      "writer": "inc-b",
      "stamp": [
        5,
        "inc-b",
        1
      ],
      "kind": "queue.membership.move",
      "target": "q1|Y",
      "payload": {
        "rank": 0
      }
    }
  ],
  "orders": "allInterleavings",
  "duplicates": "deliver every op twice",
  "expected": {
    "queues": [
      {
        "key": "q1",
        "members": [
          {
            "work": "X",
            "rank": 1
          },
          {
            "work": "Y",
            "rank": 2
          }
        ]
      }
    ],
    "why": "m3 on a removed key is stale; where m3 applied first its rank (5,inc-b) loses to the re-add's (6,inc-a)"
  }
}
