# Copy to keystore.properties (gitignored) and fill in real values to produce
# signed release builds locally. Every published release APK must be signed
# with the SAME key, or Android refuses to install it as an update over an
# existing install of the app — back this keystore up somewhere durable.
storeFile=/absolute/path/to/kudos-release.keystore
storePassword=
keyAlias=kudos-release
keyPassword=
