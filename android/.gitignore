*.jks

# Kotlin Gradle plugin 2.x scratch dir (session files, build reports).
.kotlin/

# Vendored sherpa-onnx AAR (~47 MB) — not on Maven Central, fetched locally by
# Scripts/fetch-sherpa-onnx.sh from the project's GitHub releases rather than
# committed (same reasoning as MuPDF's build artifacts on the iOS side).
app/libs/*.aar

# MuPDF is AGPL-3.0 and built locally by Scripts/build-mupdf.sh — the built
# library and its source checkout are not committed (same rule as iOS's
# xcframework). Run that script, or attach the .so to a release.
build-mupdf/
app/src/main/jniLibs/
