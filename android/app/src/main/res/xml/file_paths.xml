<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches AppUpdateInstaller's download destination: filesDir/updates/ -->
    <files-path name="updates" path="updates/" />
    <!-- Work files only; no database, preferences, cookies, or the cache root. -->
    <files-path name="works" path="works/" />
    <files-path name="originals" path="originals/" />
    <!-- The shake-time screenshot a bug report shares; only that folder of the cache. -->
    <cache-path name="bug-report" path="bug-report/" />
    <!-- A recovery copy too long for the clipboard, shared as a text file from the editor. -->
    <cache-path name="recovery-copy" path="recovery-copy/" />
</paths>
